{
  "name": "ai-agents-orchestrator",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "bun run orchestrator-team.ts",
    "agent": "bun run agent.ts",
    "dev": "bun --watch run orchestrator-team.ts",
    "test": "bun test",
