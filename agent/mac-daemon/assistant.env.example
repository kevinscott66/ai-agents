# Дополнение к окружению Mac daemon (не server .env).
MAC_CALENDAR_ENABLED=false
# Только установленные приложения, указанные владельцем локально:
MAC_WORKSPACE_APPS=com.apple.iCal,com.apple.Notes
# MAC_CONTROL: закрытый список команд (lock, sleep, volume, open_app, напоминания, события).
# Выключено, пока владелец сам не включит. Выключение/перезагрузка — всегда через подтверждение в чате.
MAC_CONTROL_ENABLED=false
# Псевдонимы приложений для open_app: alias=bundle.id через запятую.
MAC_APPS=notes=com.apple.Notes,calendar=com.apple.iCal,music=com.apple.Music
