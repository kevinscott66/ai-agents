# =============================================================================
# agent-team — environment configuration
# Copy to `.env` and fill in real secrets. Never commit `.env`.
# =============================================================================

# Anthropic
ANTHROPIC_API_KEY=                  # Optional. Raw API fallback; not needed with Claude subscription.
ANTHROPIC_SMALL_MODEL=              # Optional. Fast/cheap model, e.g. claude-haiku-4-5.
ANTHROPIC_LARGE_MODEL=              # Optional. Capable model, e.g. claude-opus-4-7.
ANTHROPIC_SMALL_MODEL_SDK=          # Optional. Same, but for the subscription (Agent SDK) path: CLI alias, e.g. haiku.
ANTHROPIC_LARGE_MODEL_SDK=          # Optional. Same, but for the subscription (Agent SDK) path. Unset = CLI default.
ANTHROPIC_MAX_CONCURRENCY=          # Optional. Parallel Anthropic calls: integer 1..16 (default 3).
ANTHROPIC_REQUEST_TIMEOUT_MS=       # Optional. Per-request timeout, ms: integer 1000..600000 (default 120000).
OPENAI_API_KEY=                     # Optional. Fallback/alt provider if used.

# Telegram bot tokens (12 roles)
# Имена задаёт код: `envToken` в agent/characters/index.ts. У оркестратора это
# TELEGRAM_BOT_TOKEN — исторически, до появления схемы TG_TOKEN_<ROLE>. Здесь
# годами стояло TG_TOKEN_ORCHESTRATOR: переменная, которую не читает никто, так
# что развёртывание по этому шаблону поднимало 11 ролей из 12 и молчащего
# главного бота. Сверку держит tests/env-example-tokens.test.ts.
TELEGRAM_BOT_TOKEN=                 # Orchestrator bot — routes work to the team.
TG_TOKEN_PM=                        # Project Manager role bot.
TG_TOKEN_PRODUCT=                   # Product role bot.
TG_TOKEN_BACKEND=                   # Backend engineer role bot.
TG_TOKEN_FRONTEND=                  # Frontend engineer role bot.
TG_TOKEN_TGDEV=                     # Telegram-bot developer role bot.
TG_TOKEN_AIENG=                     # AI engineer role bot.
TG_TOKEN_QA=                        # QA role bot.
TG_TOKEN_DESIGN=                    # Designer role bot.
TG_TOKEN_COPY=                      # Copywriter role bot.
TG_TOKEN_SMM=                       # SMM role bot.
TG_TOKEN_PERM=                      # Permissions / on-call role bot.
TELEGRAM_ALLOWED_GROUP_IDS=         # Optional. Comma-separated TG chat IDs allowed to interact.

# Mini App
MINIAPP_ENABLED=true                # Enable embedded Mini App HTTP server (true/false).
MINIAPP_PORT=8787                   # Port for /api/* and Mini App static serving.
MINIAPP_PUBLIC_URL=                 # HTTPS URL Telegram opens, e.g. https://agents.example.com:8443.
MINIAPP_BOT_TOKEN=                  # Bot token used for Telegram initData verification.
MINIAPP_ALLOWED_USER_IDS=           # Optional. Comma-separated TG user IDs allowed to use the app.
MINIAPP_ADMIN_USER_IDS=             # Optional. Comma-separated TG user IDs with admin privileges.

# Watchdog
WATCHDOG_INTERVAL_MS=               # How often to run health checks (ms).
WATCHDOG_SILENCE_MS=                # Silence threshold before alerting (ms).
WATCHDOG_TG_ALERTS=                 # true/false — send Telegram alerts on failures.

# Self-diag
SELF_DIAG_ENABLED=                  # true/false — enable periodic self-diagnostic runs.
SELF_DIAG_INTERVAL_MS=              # Self-diag interval in ms.

# Backup
BACKUP_ENABLED=                     # true/false — enable scheduled SQLite/memory backups.
BACKUP_DIR=./backups                # Backup destination directory (host-mounted in compose).
MEMORY_DB_PATH=                     # Optional override for SQLite DB path.
MEMORY_DIR=                         # Optional override for memory/wiki directory.
MEMORY_HISTORY_LIMIT=               # Optional cap on retained history entries; empty = 30.
TOKEN_BUDGET_DEFAULT=               # Optional default token budget per task.

# Digest
DIGEST_ENABLED=                     # true/false — enable daily digest.
DIGEST_HOUR_UTC=                    # Hour of day (UTC, 0-23) to post the digest.

# Observability (T-340)
LOG_LEVEL=                          # debug|info|warn|error. Default: info in prod (NODE_ENV=production), debug locally.
LOG_REDACT=                         # Set to 0 to DISABLE PII redaction in logs (local debugging only).
UNCAUGHT_EXCEPTION_POLICY=          # keep — НЕ выходить при необработанном исключении (аварийный тормоз дежурного).
                                    # По умолчанию (пусто/любое другое значение) процесс логирует, пишет alert и выходит с 1;
                                    # systemd поднимает чистый за ~3s. keep возвращает старое поведение — работу в неизвестном состоянии.

# External integrations (role-gap tools, 2026-06-10)
FIGMA_TOKEN=                        # Figma personal access token (read-only). Tool: GET_FIGMA_FILE (designer).
TGSTAT_TOKEN=                       # TGStat API token (channel statistics). Tool: GET_CHANNEL_STATS (smm).
TELEMETR_TOKEN=                     # Telemetr.io API token (optional; TGStat alt — no consumer yet).
GITHUB_READ_TOKEN=                  # Fine-grained GitHub PAT (READ-ONLY, repo-scoped). Tool: GET_GITHUB_STATUS (backend/qa).
GITHUB_REPO=                        # owner/repo override for GET_GITHUB_STATUS (default: kevinscott66/ai-agents).
# Аудит 2026-08-29: трёх строк ниже в шаблоне не было вовсе. Первые две читает
# lib/dispatch/github.ts (без них дочерний `gh` не аутентифицирован), третью —
# deploy/vps-autonomous/autonomous-cycle.sh из ЭТОГО же файла.
GITHUB_TOKEN=                       # PAT для дочернего `gh` (REVIEW_AND_MERGE и др.). Подставляется в GH_TOKEN, если тот пуст.
GH_TOKEN=                           # То же напрямую. Задан — GITHUB_TOKEN его не перебивает.
CLAUDE_CODE_OAUTH_TOKEN=            # Claude Code subscription credential. With this set, Agent SDK is the default.
MAX_REPLY_TOKENS=                   # Ceiling tokens per agent reply (default 1500; raise if replies get cut off).

# =============================================================================
# Ниже — блок, добавленный аудитом 2026-08-11. До него шаблон описывал 32 имени
# из 84, которые читает код: недостающие 52 приходилось искать по исходникам.
# Сверку кода и шаблона в обе стороны держит tests/env-example-coverage.test.ts.
# Пустое значение = «код возьмёт свой дефолт», он указан в комментарии.
# =============================================================================

# Runtime
NODE_ENV=                           # production на сервере. Влияет на дефолт LOG_LEVEL (info вместо debug).
HANDLER_TIMEOUT_MS=                 # Потолок на обработку одного сообщения, мс. Default: 300000 (5 мин).
MAX_TOOL_ITERS=                     # Сколько раундов инструментов разрешено агенту за ответ. Default: 14.
MAKER_MAX_TOKENS=                   # Потолок ответа у «делающих» ролей (handoff). Default: 8000.
USE_AGENT_SDK=                      # "true" → subscription; "false" → explicit raw API; empty auto-selects subscription when OAuth is set.
CLAUDE_BIN=                         # Путь к бинарю claude для Agent SDK. Пусто = ищется в PATH.
SPAWN_ROLE_PROVIDER=internal        # internal|claude|codex; unknown values fail closed. Codex requires a local CLI/runtime.

# Mini App / HTTP-периметр
MINIAPP_HOST=                       # Интерфейс, на котором слушает Mini App. Default: 127.0.0.1 (наружу — только через nginx).
MINIAPP_ALLOWED_ORIGINS=            # CSV origin'ов для CORS. Пусто = НЕ fail-closed: остаются http://localhost:5173 и http://127.0.0.1:5173 (дефолт разработки). Браузер шлёт Origin и на своих POST'ах — если Mini App открывают вкладкой, а не в Telegram, перечисли её публичный origin, иначе POST'ы получат 403.
METRICS_TOKEN=                      # Bearer для GET /metrics. Пусто = эндпоинт закрыт (fail-closed).
TELEGRAM_ADMIN_USER_IDS=            # CSV админов для /-команд в Telegram. Пусто (в т.ч. пустая строка) = падает обратно на MINIAPP_ADMIN_USER_IDS. Элементы строго целые положительные — «12345x» отбрасывается целиком, а не режется до 12345.
RATE_LIMIT_PER_CHAT_PER_MIN=        # Сообщений на чат в минуту. Default: 30.
RATE_LIMIT_PER_BOT_PER_CHAT_PER_MIN=  # Сообщений одного бота в один чат в минуту. Default: 20 (столько же считает флудом Telegram). Зажимается сверху значением RATE_LIMIT_PER_CHAT_PER_MIN.
INGEST_RATE_MAX_PER_WINDOW=         # Приём вложений: событий на окно. Default: 15.
INGEST_RATE_WINDOW_MS=              # Окно для INGEST_RATE_MAX_PER_WINDOW, мс. Default: 60000.

# Mac-bridge (MAC_RUN_CLAUDE — исполнение кода на Mac; RCE by design)
MAC_BRIDGE_HOST=                    # Интерфейс моста. Default: 127.0.0.1. Менять только осознанно.
MAC_BRIDGE_PORT=                    # Порт моста. Default: 8788.
MAC_BRIDGE_SECRET=                  # Общий секрет моста. Пусто = мост отвергает любое подключение (fail-closed).
MAC_BRIDGE_PATH=/                   # Exact WebSocket path accepted by the bridge.
MAC_BRIDGE_ALLOWED_ORIGINS=         # CSV exact browser Origins; empty accepts daemon connections without Origin only.
MAC_BRIDGE_AUTH_TIMEOUT_MS=         # Pre-auth WebSocket timeout. Default: 10000.
MAC_BRIDGE_MAX_CONNECTIONS=         # Global bridge connection cap. Default: 16.
MAC_BRIDGE_MAX_CONNECTIONS_PER_IP=  # Per-source bridge connection cap. Default: 4.
MAC_USER_IDS=                       # CSV Telegram user id, которым разрешён MAC_RUN_CLAUDE. Пусто = никому.
MAC_ALLOW_BYPASS=                   # "true" снимает проверку разрешений у моста. Оставляй пустым.
MAC_DENIED_PROMPT_PATTERNS=         # CSV РЕГУЛЯРОК (не подстрок), запрещённых в prompt. Пусто = список пуст.
MAC_RUN_TIMEOUT_MS=                 # Сколько мост ждёт прогон, после чего шлёт на мак cancel. Default: 300000 (5 мин).
MAC_MAX_CONCURRENT_RUNS=            # Сколько прогонов может идти одновременно. Сверх — отказ mac_busy. Default: 2. Мусор и 0 → 2.
                                    # Запятая внутри {n,m} шаблон не делит; нечитаемый шаблон = отказ на весь вызов.

# Userbot (gramjs; аккаунт-человек, не бот)
TELEGRAM_API_ID=                    # api_id с my.telegram.org. Нужен и юзерботу, и login-userbot.ts.
TELEGRAM_API_HASH=                  # api_hash оттуда же.
TELEGRAM_USERBOT_PHONE=             # Телефон аккаунта. Пусто = юзербот не поднимается вообще.
USERBOT_SESSION_PATH=               # Файл сессии. Default: data/userbot.session.
USERBOT_SESSION_KEY=                # Обязательная пассфраза: userbot-сессия всегда шифруется на диске.
USERBOT_ROUTER_ENABLED=             # "true" → входящие юзербота уходят в роутер ролей.
USERBOT_FLOOD_MAX_PER_WINDOW=       # Анти-flood: действий на окно. Default: 20.
USERBOT_FLOOD_WINDOW_MS=            # Окно для анти-flood, мс. Default: 60000.
# Пер-ролевые имена собираются в коде и потому здесь не перечислены:
#   USERBOT_SESSION_<ROLE>, USERBOT_ALLOWED_CHATS_<ROLE>, TOKEN_BUDGET_<ROLE>.

# Web search (инструмент модели)
WEB_SEARCH_ENABLED=                 # "true" → агентам доступен web_search.
WEB_SEARCH_MAX_USES=                # Поисков на один ответ. Default: 3.
WEB_SEARCH_ALLOWED_DOMAINS=         # CSV allowlist доменов. Пусто = без ограничений.
WEB_SEARCH_BLOCKED_DOMAINS=         # CSV blocklist доменов.

# Приватность (оба выключаются значением "0" — так и задумано, но знай об этом)
WIKI_PII_FILTER=                    # "0" ОТКЛЮЧАЕТ вычистку PII при записи в вики.
OPENAI_PROMPT_REDACT=               # "0" ОТКЛЮЧАЕТ вычистку PII из промпта, уходящего в OpenAI.

# Публикация на сайт
SITE_INGEST_URL=                    # Endpoint приёма дайджеста. Пусто = публикация на сайт выключена.
SITE_INGEST_TOKEN=                  # Токен к нему.
SITE_INGEST_TIMEOUT_MS=             # Бюджет одного POST статьи на сайт из approve-poll. Default: 15000.
SITE_INGEST_CHANNEL_ID=             # Канал, чьи посты становятся страницами сайта. Пусто = DELABS_CHANNEL_ID, затем -1004471352065. Посты в остальные командные каналы на сайт НЕ уходят.
SITE_INGEST_ALLOW_IN_TESTS=         # Только для тестов моста: "1" разрешает отправку под `bun test`. В прод НЕ ставить. Без неё прогон тестов молчит — восемь страниц «Крючок.» на delabs.space родил именно `bun test` на VPS (T-743).
DELABS_CHANNEL_ID=                  # Публичный канал DeLabs. Читают tools/daily-draft.ts, tools/approve-poll.ts и мост на сайт. Пусто = -1004471352065.
DELABS_SITE_BASE=                   # База адресов сайта для ссылок в постах и запросов к его API. Пусто или адрес без http(s):// = https://delabs.space. Хвостовой слэш снимается.
DELABS_DRAFTS_PENDING=              # Файл черновика между daily-draft.ts и approve-poll.ts. Пусто = /opt/web3-puls/drafts/pending.json.
WEEKLY_AHEAD=                       # Ручная строка «что дальше» в недельном обзоре (tools/weekly-draft.ts). Пусто = блок не печатается.
DELABS_TZ=                          # Часовой пояс, в котором печатаются даты постов канала (lib/delabs-text.ts). Пусто = Europe/Moscow. VPS живёт в UTC, и без этого «12 августа 21:30» уезжало на 13-е.

# Обслуживание БД и хранение
DB_MAINT_ENABLED=                   # "false" ВЫКЛЮЧАЕТ ночное обслуживание. Любое другое значение (и пусто) = включено.
DB_MAINT_HOUR_UTC=                  # Час запуска, UTC. Default: 4.
DB_MAINT_ARCHIVE_DAYS=              # Возраст строк для архивации, дней. Default: 30.
MESSAGES_RETENTION_DAYS=            # Сколько держим сообщения. Default: 90. 0 = ВЫКЛЮЧИТЬ уборку совсем (тела сообщений остаются навсегда), а не «по умолчанию».
APPROVAL_TTL_HOURS=                 # Через сколько нерешённая заявка на одобрение протухает. Default: 24. Просроченную нельзя ни одобрить, ни исполнить — агент запрашивает заново.
MAX_PENDING_APPROVALS=              # Сколько нерешённых заявок на одобрение может держать ОДНА роль. Default: 10. Сверх предела действие отбивается ошибкой, а не встаёт в очередь.
COLD_STORAGE_DAYS=                  # Сколько держим холодный экспорт. Default: 365. 0 = выгрузить весь архив целиком.

# Здоровье и алерты
HEALTH_ENABLED=                     # "false" ВЫКЛЮЧАЕТ health-монитор. Пусто = включён.
HEALTH_INTERVAL_MS=                 # Период health-проверок, мс. Пусто = дефолт монитора.
ALERT_APPROVAL_BACKLOG_MIN=         # Сколько апрувов в очереди считать проблемой. Default: 10.
ALERT_APPROVAL_BACKLOG_AGE_MINUTES= # Возраст самого старого апрува для алерта, мин. Default: 60.
ALERT_APPROVAL_BACKLOG_COOLDOWN_MINUTES= # Пауза между повторами этого алерта, мин. Default: 360.
ALERT_RATE_LIMIT_STORM_COUNT=       # Сколько 429 в окне считать штормом. Default: 50.
ALERT_RATE_LIMIT_STORM_WINDOW_MINUTES=   # Окно для шторма, мин. Default: 5.
ALERT_RATE_LIMIT_STORM_COOLDOWN_MINUTES= # Пауза между повторами, мин. Default: 60.

# Межагентные лимиты
HANDOFF_MAX_INVOCATIONS=            # Потолок вызовов в одном дереве делегирования. Default: 16.
DISCUSSION_MAX_DEPTH=               # Глубина discussion-режима. Default: 8.
# Оба потолка — целое >= 1. Ноль/отрицательное/мусор игнорируются с WARN в лог:
# ноль тут значил бы не «ноль раз», а «анти-луп срабатывает всегда», то есть
# self-diag выключен и текст любой ошибки подменён на «circuit breaker tripped».
INTER_AGENT_FIX_CHAIN_MAX_DEPTH=    # Глубина цепочки авто-починок. Default: 3.
DIAG_TASK_MAX_PER_HOUR=             # Потолок диагностических тасков в час. Default: 5.

MAC_AUTONOMOUS=                     # "true" → оркестратор запускает MAC_RUN_CLAUDE БЕЗ approval (только в чате с autonomy=auto). Дефолт: approval. RCE — включай осознанно.
