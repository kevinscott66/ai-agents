# Очередь задач роли из TASKS.md для автономного цикла.
#
# Вход:  TASKS.md
# Пере-  ROLE_RE — регулярка роли, например "role:backend[^a-z-]"
# менная (скобка [^a-z-] нужна, чтобы role:pm не матчил role:pmx)
# Выход: заголовки открытых задач этой роли, по одной на строку, в порядке файла.
#
# Почему не однострочный grep (было так, поймано 2026-08-13):
#
#   1. Признак «не для бота» чаще стоит НЕ в заголовке, а в теле задачи.
#      `needs-human:` в TASKS.md встречается в заголовке ноль раз и в теле —
#      семь. Греп по заголовкам выдавал такие задачи агенту как работу.
#
#   2. Брать «всё тело до следующего ###» тоже нельзя: в конце секций стоят
#      сводки и цитаты, где ✅ и `deferred:` относятся к ЧУЖИМ задачам. По ним
#      T-735 (audit_logs пуст — реально открытая дыра в аудите) отсекалась как
#      закрытая. Поэтому смотрим заголовок + первые шесть непустых строк: теги
#      живут там, а сводки — ниже.
#
# Смещение в любую сторону не равноценно. Лишняя задача в очереди — бот берёт
# работу, которую нельзя отдавать боту. Недостающая — очередь короче, и агент
# читает TASKS.md сам, как читал до появления этого фильтра. Поэтому при
# сомнении исключаем.

/^### T-[0-9]+/ { flush(); hdr = $0; body = $0; n = 0; next }
/^### /        { flush(); next }
{ if (hdr != "" && n < 6 && $0 !~ /^[[:space:]]*$/) { body = body "\n" $0; n++ } }
END { flush() }

function flush() {
  if (hdr != "" && hdr ~ ROLE_RE && body !~ /needs-human:|dropped:|deferred:|✅|ЗАКРЫТ|DONE|done:/)
    print hdr
  hdr = ""; body = ""; n = 0
}
