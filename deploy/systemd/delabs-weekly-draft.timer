# delabs-weekly-draft.timer
# Раз в неделю, воскресенье 18:00 UTC (21:00 МСК).
#
# Почему воскресенье вечером: окно отбора — [понедельник 00:00 МСК, следующий
# понедельник 00:00 МСК), то есть к этому моменту неделя фактически закрыта, а
# воскресный дайджест (08:00 UTC) уже вышел и попал в подборку.
#
# Почему 18:00, а не сразу после дневного: слот очереди один, и до полудня в
# нём обычно лежит неодобренный дневной черновик. approve-poll ходит каждые 30
# минут, так что к вечеру слот, как правило, свободен. Если нет — недельный
# прогон тихо выходит с кодом 0 (см. .service).
#
# Почему ещё и понедельник (аудит 2026-08-20): «слот занят» и «сайт недоступен»
# в воскресенье означали потерю итогов недели целиком — следующий запуск таймера
# только через семь дней, и подводить он будет уже другую неделю. Понедельничный
# прогон подхватывает ту же неделю (см. recapBounds) и выходит сразу, если
# воскресный успел — метка weekly-<понедельник>.done в каталоге черновиков.
#
# Persistent=true → пропущенный из-за простоя VPS запуск догонится при старте.
# Пост при этом всё равно уйдёт только через апрув владельца, так что «догон»
# ничем не грозит: в худшем случае превью придёт в понедельник.
[Unit]
Description=Run DeLabs weekly recap draft (Sun+Mon 18:00 UTC, once per week)

[Timer]
OnCalendar=Sun,Mon *-*-* 18:00:00
Persistent=true

[Install]
WantedBy=timers.target
