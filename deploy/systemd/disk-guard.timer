# Раз в час. Чаще незачем: раздел заполняется сутками, а не минутами, и
# единственный быстрый едок — выкатка, у которой есть своя предполётная
# проверка (deploy/deploy.sh вызывает disk-guard.sh --need до первого rsync).
#
# Persistent=true — после перезагрузки прогон случится сразу, а не через час:
# именно после перезагрузки полезно узнать, что журнал развернулся заново или
# что /tmp не почистился.
[Unit]
Description=Hourly disk headroom check

[Timer]
OnCalendar=hourly
Persistent=true
# Разброс, чтобы сторож не просыпался ровно в :00 вместе с ротацией журнала и
# apt-daily: df в этот момент показывает середину чужой работы.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
