# Каждые полчаса, в :15 и :45 — через десять минут после обновления корпуса
# (delabs-site-refresh, :05 и :35). Свежий выпуск канала попадает на сайт с
# ближайшим обновлением, редактура приходит следующим прогоном, а сайт
# подхватывает её на следующей пересборке. От поста в канале до вычитанного
# текста — около часа.
#
# До 22.09.2026 прогон шёл раз в сутки, в 03:10 UTC, и всё, что канал писал
# днём, почти сутки стояло на сайте текстом поста: заголовок-ярлык «CypherSquad:
# Минт NFT» и одна строка вместо лида и разбора. Пустой прогон стоит пару
# секунд (корпус прочитан, редактировать некого, в модель не ходим), так что
# частота ничего не стоит, а оба юнита — oneshot: новый прогон не начнётся,
# пока не закончился прежний.
#
# Persistent=true — если сервер в этот час не работал, прогон случится при
# ближайшей возможности.
[Unit]
Description=Run DeLabs site editorial every 30 minutes (:15 and :45)

[Timer]
OnCalendar=*-*-* *:15,45:00
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
