# Раз в сутки, ранним утром по Москве: к тому часу, когда читатель открывает
# сайт, вчерашние выпуски уже вычитаны. Днём канал продолжает пополняться, и
# свежий выпуск до следующего прогона стоит с текстом поста как есть — это
# хуже вычитанного, но несравнимо лучше 404, и редактура потом заменит текст,
# не меняя id и адреса страницы.
#
# Persistent=true — если сервер в этот час не работал, прогон случится при
# ближайшей возможности, а не пропадёт до завтра.
[Unit]
Description=Run DeLabs site editorial once per day (03:10 UTC)

[Timer]
OnCalendar=*-*-* 03:10:00
Persistent=true
# Разброс, чтобы редактура не начиналась ровно в тот момент, когда таймер
# обновления корпуса (:05 и :35) уже что-то делает с теми же файлами.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
